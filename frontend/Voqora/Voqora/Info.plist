<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon.icns</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSBackgroundOnly</key>
	<false/>
	<key>LSUIElement</key>
	<false/>
	<key>NSAccessibilityUsageDescription</key>
	<string>Voqora needs accessibility access to read selected text from other applications.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Voqora connects to your Audiobookshelf server on your local network when you upload an audiobook.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voqora listens through your microphone only while you dictate, so it can type what you say into the app you are using.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Voqora transcribes your dictation on this Mac. Audio is sent to Apple only if you turn on server recognition for a language without on-device support.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Voqora needs to control other apps to adjust music volume while speaking.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Speak with Voqora</string>
			</dict>
			<key>NSMessage</key>
			<string>speakWithVoqora</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Voqora Library</string>
			</dict>
			<key>NSMessage</key>
			<string>addToVoqoraLibrary</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<!--
	 Sparkle's embedded downloader XPC service needs a stable Developer ID
	 identity. Early-access builds are Apple Development signed and AppUpdater
	 never starts Sparkle, so keep the in-process downloader until the notarized
	 distribution path is enabled. Archive verification remains EdDSA-backed.
	-->
	<key>SUEnableDownloaderService</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://himudigonda.github.io/Voqora/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>LSEnvironment</key>
	<dict>
		<key>LLVM_PROFILE_FILE</key>
		<string>/dev/null</string>
	</dict>
</dict>
</plist>
