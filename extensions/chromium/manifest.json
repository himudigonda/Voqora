{
  "manifest_version": 3,
  "name": "Voqora",
  "short_name": "Voqora",
  "version": "1.0.0",
  "description": "Read selected text or whole pages aloud with the Voqora app on your Mac.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Voqora",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read selection with Voqora"
    },
    "stop-reading": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop Voqora"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  }
}
